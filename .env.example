# Copy to .env (never commit it) or set these in your host's dashboard.

# --- Public URL (required in production: sitemap, canonical, Open Graph) ---
SITE_URL=https://example.com
VITE_SITE_URL=https://example.com

# --- AI voice (server-side only) ---
AI_PROVIDER=gemini            # gemini | openrouter | groq | xai. Its key is REQUIRED; nothing else is substituted.
AI_FALLBACK_PROVIDERS=        # optional, explicit, comma-separated, e.g. groq,openrouter. Empty = no fallback (default).
# ALLOW_START_WITHOUT_AI=1    # production only: start even if the selected provider has no key
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=
# GEMINI_MODELS=a,b,c
# GROQ_MODEL=
# OPENROUTER_MODEL=
# XAI_MODEL=

# --- Database and auth (required in production) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
BETTER_AUTH_SECRET=           # 32+ random chars: openssl rand -hex 32
BETTER_AUTH_URL=https://example.com

# --- Build target (optional) ---
# NITRO_PRESET=vercel         # default. Use node-server for Docker/VPS.
